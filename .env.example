# Copy this file to .env and fill in your printer's details.
# Find them on the printer's screen: IP address and Access Code under the network/LAN settings,
# serial number under the device info (also shown in Bambu Studio and Bambu Handy).

# Required
BAMBU_IP=192.168.1.50
BAMBU_SERIAL=01P00A000000000
BAMBU_ACCESS_CODE=12345678

# Optional: name shown in the dashboard header (defaults to the detected model, e.g. "P1S")
BAMBU_NAME=

# Optional: camera source. auto (default) picks based on the model:
#   jpeg = A1, A1 mini, P1P, P1S (port 6000)
#   rtsp = X1, X1 Carbon, X1E, H2D (port 322, needs ffmpeg on your PATH)
#   off  = no camera
BAMBU_CAMERA=auto

# Optional: set to 1 to run with fake data instead of a real printer
# BAMBU_DEMO=1
